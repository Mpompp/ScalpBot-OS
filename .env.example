# =============================================================================
# ScalpBot Environment Variables Template
# =============================================================================
# Copy this file to .env and set your credentials.
# Environment variables override YAML configuration automatically.

SCALP_SYMBOL=XAUUSDc
SCALP_LOG_LEVEL=info
SCALP_BROKER_TYPE=mt5
SCALP_MT5_CMD=127.0.0.1:5555
SCALP_MT5_STREAM=127.0.0.1:5556

# Telegram Alerting Credentials (Keep private, DO NOT commit to GitHub)
SCALP_TG_TOKEN=your_telegram_bot_token_here
SCALP_TG_CHAT=your_telegram_chat_id_here
SCALP_WEBHOOK_URL=
